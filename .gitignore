# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# IDE and VSCode
.vscode/
.idea/
*.swp

# Node and UI
node_modules/
dist/
build/
.npm/

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Models
models/
*.bin
*.pth
*.pt

# Git
.DS_Store

# Python packaging / tool caches
*.egg-info/
.ruff_cache/
.mypy_cache/
.pytest_cache/

# VSCode extension build output (generated by `npm run compile` / `vsce package`)
vscode-extension/out/
vscode-extension/node_modules/
*.vsix

# The GitHub Action ships its bundled build: keep dist/ for it only
!github-action/dist/
!github-action/dist/**
